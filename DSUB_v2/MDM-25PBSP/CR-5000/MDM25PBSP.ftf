(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c121.9
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 60950
            (pt 0 0)
          )
        )
      )
      (pad r121.9_121.9
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 121900)
            (height 121900)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c396
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 198000
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c121.9h71.1
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 35550
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c121.9))
          (noconnect (pad c121.9))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c121.9))
          (noconnect (pad c121.9))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c121.9))
          (noconnect (pad c121.9))
        )
        (padSet (footLayer Inner)
          (clearance (pad c121.9))
          (connect (pad c121.9))
          (noconnect (pad c121.9))
        )
        (padSet (footLayer Bottom)
          (connect (pad c121.9))
          (noconnect (pad c121.9))
        )
      )
      (padstack r121.9_121.9h71.1
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 35550
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad r121.9_121.9))
          (noconnect (pad r121.9_121.9))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r121.9_121.9))
          (noconnect (pad r121.9_121.9))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r121.9_121.9))
          (noconnect (pad r121.9_121.9))
        )
        (padSet (footLayer Inner)
          (clearance (pad r121.9_121.9))
          (connect (pad r121.9_121.9))
          (noconnect (pad r121.9_121.9))
        )
        (padSet (footLayer Bottom)
          (connect (pad r121.9_121.9))
          (noconnect (pad r121.9_121.9))
        )
      )
      (padstack c396h264
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 132000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c396))
          (noconnect (pad c396))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c396))
          (noconnect (pad c396))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c396))
          (noconnect (pad c396))
        )
        (padSet (footLayer Inner)
          (clearance (pad c396))
          (connect (pad c396))
          (noconnect (pad c396))
        )
        (padSet (footLayer Bottom)
          (connect (pad c396))
          (noconnect (pad c396))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "MDM25PBSP"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -686000 -518000
                        (width 10000)
                      )
                      (pt 3734000 -518000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
